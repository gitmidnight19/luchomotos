# ============================================================
#  Servidor del taller  (copie este archivo como .env)
# ============================================================
# Todas las variables son OPCIONALES: sin .env el sistema usa
# estos mismos valores por defecto.

# Puerto en el que escucha el servidor.
TALLER_PUERTO=8321

# 0.0.0.0 permite que los celulares entren por WiFi.
# Poner 127.0.0.1 lo deja accesible solo desde este computador.
TALLER_HOST=0.0.0.0

# Carpeta donde vive la base de datos y los respaldos.
# TALLER_DATA_DIR=C:/Users/Monto/Desktop/sistema contable/data

# Nombre del archivo de base de datos (util para llevar
# varios talleres en el mismo equipo).
TALLER_DB_NOMBRE=taller.db

# Muestra en consola cada consulta SQL. Solo para diagnosticar.
TALLER_DEBUG=false
