# ============================================================
#  App movil  (copie este archivo como .env)
# ============================================================
# Direccion por defecto del servidor del taller. Si la define,
# la app arranca ya conectada y se salta la pantalla inicial.
#
# Debe ser la IP del computador en la red WiFi, NO "localhost":
# el celular es otro equipo y "localhost" apuntaria a si mismo.
#
# El prefijo EXPO_PUBLIC_ es obligatorio para que Expo la exponga
# a la app. Tras cambiarla hay que reiniciar con: npx expo start -c

EXPO_PUBLIC_API_URL=http://192.168.1.100:8321
